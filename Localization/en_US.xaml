    <sys:String x:Key="LOCGameSnapFullscreen_ReviewTitle">Review Unmatched Screenshots</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_SelectPreview">Select a file to preview</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_SearchAssign">Search &amp; Assign</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_Close">Close</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_Skip">Skip</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_SelectGame">Select game</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_Back">Back</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_Navigate">Navigate</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_Space">SPACE</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_Clear">CLEAR</sys:String>

    <sys:String x:Key="LOCGameSnapFullscreen_VideoNoPreview">Video — no preview</sys:String>
    <sys:String x:Key="LOCGameSnapFullscreen_CannotLoadPreview">Cannot load preview</sys:String>
