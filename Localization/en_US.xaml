    <sys:String x:Key="LOCGameSnapFullscreen_DeleteConfirm">Delete {0}?</sys:String>

    <!-- ==================== Main Menu and Game Menu ==================== -->
    <sys:String x:Key="LOCGameSnapOrganizeScreenshots">Organize Screenshots</sys:String>
    <sys:String x:Key="LOCGameSnapOpenLog">Open Log</sys:String>
    <sys:String x:Key="LOCGameSnapOpenDictionary">Open Dictionary</sys:String>
    <sys:String x:Key="LOCGameSnapReviewUnmatched">Review Unmatched Screenshots</sys:String>
    <sys:String x:Key="LOCGameSnapReviewUnmatchedFullscreen">Fullscreen Review Unmatched</sys:String>

