    <sys:String x:Key="LOCGameSnap_Error_FolderNotFound">❌ Error: Screenshot ({1}) for game ({0}) failed to organize to folder ({2}), please check if the folder exists</sys:String>
    <sys:String x:Key="LOCGameSnap_Error_MoveFailed">❌ Error: Screenshot ({1}) for game ({0}) failed to move to folder ({2})</sys:String>
