<UserControl x:Class="GameSnapPlugin.Views.EmulatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="620">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <CheckBox Content="{DynamicResource LOCGameSnap_Emulators_EnableSupport}"
                      IsChecked="{Binding Settings.EnableEmulatorSupport}"
                      FontWeight="SemiBold"
                      ToolTip="{DynamicResource LOCGameSnap_Emulators_EnableSupportTip}"/>
            <TextBlock Text="{DynamicResource LOCGameSnap_Emulators_SubLabel}"
                       Foreground="Gray" FontSize="11" Margin="20,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,0,0,12"/>

        <!-- Warning when ForceCreateFolder is off -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,8"
                Background="#1a2a1a" BorderBrush="#4caf50" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding Settings.ForceCreateFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource LOCGameSnap_Emulators_TipIcon}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#a0d0a0"
                        Text="{DynamicResource LOCGameSnap_Emulators_ForceCreateTip}"/>
            </StackPanel>
        </Border>

        <!-- Emulator list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EmulatorProfiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,10"
                                BorderThickness="1" CornerRadius="4"
                                ToolTip="{DynamicResource LOCGameSnap_Emulators_ItemTooltip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#333"/>
                                    <Setter Property="Background" Value="#1a1a1a"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="BorderBrush" Value="#0f3460"/>
                                            <Setter Property="Background" Value="#16213e"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Enable toggle -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Enabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                                <!-- Name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <!-- Path -->
                                <TextBox Grid.Column="2"
                                         Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         FontSize="11">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="#e0e0e0"/>
                                            <Setter Property="Background" Value="#0d0d1a"/>
                                            <Setter Property="BorderBrush" Value="#333"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustom}" Value="False">
                                                    <Setter Property="Foreground" Value="#607080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Browse -->
                                <Button Grid.Column="3"
                                        Content="{DynamicResource LOCGameSnap_Emulators_Browse}"
                                        Padding="8,4"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="BrowseButton_Click"/>

                                <!-- Status -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StatusText}"
                                           Foreground="{Binding StatusColor}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add custom emulator -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource LOCGameSnap_Emulators_Add}"
                    Padding="12,6"
                    Command="{Binding AddEmulatorCommand}"
                    ToolTip="{DynamicResource LOCGameSnap_Emulators_AddTip}"/>
            <Button Content="{DynamicResource LOCGameSnap_Emulators_Remove}"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Command="{Binding RemoveEmulatorCommand}"
                    ToolTip="{DynamicResource LOCGameSnap_Emulators_RemoveTip}"/>
        </StackPanel>
    </Grid>
</UserControl>