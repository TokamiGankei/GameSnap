<Window x:Class="GameSnapPlugin.Views.FullscreenReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#000000"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="KeyStyle" TargetType="Button">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#1a6fb5"/>
                                <Setter Property="BorderBrush" Value="#4a9fe5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a4a6a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0d4a8a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ══════════════════════════════════════════════════
             TELA PRINCIPAL
             ══════════════════════════════════════════════════ -->
        <Grid x:Name="MainScreen">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_ReviewTitle}"
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SubtitleLabel"
                               FontSize="13" Foreground="#666666"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CounterLabel"
                           FontSize="16" Foreground="#555555"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- File list -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="#0a0a0a" Margin="0,0,1,0">
                <ListBox x:Name="FileList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="FileList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="13" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DateString}"
                                           FontSize="11" Foreground="#555555"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1a6fb5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Preview -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="NoPreviewLabel"
                           Text="{DynamicResource LOCGameSnapFullscreen_SelectPreview}"
                           FontSize="18" Foreground="#333333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                  Background="#0a0a0a">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="32,0">
                    <!-- A -->
                    <Border Background="#1a6fb5" CornerRadius="16"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_SearchAssign}"
                               Foreground="#aaaaaa" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <!-- B -->
                    <Border Background="#333333" CornerRadius="16"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_Close}"
                               Foreground="#aaaaaa" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <!-- Start -->
                    <Border Background="#333333" CornerRadius="16"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="≡" FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_Skip}"
                               Foreground="#aaaaaa" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             TELA DE BUSCA (teclado próprio)
             ══════════════════════════════════════════════════ -->
        <Grid x:Name="SearchScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Border Grid.Row="0" Background="#111111"
                    BorderBrush="#1a6fb5" BorderThickness="0,0,0,2">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍"
                               FontSize="22" Foreground="#1a6fb5"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="1" x:Name="SearchQueryLabel"
                               FontSize="28" Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="SearchCursorLabel"
                               Text="|" FontSize="28" Foreground="#1a6fb5"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" x:Name="SearchFileLabel"
                               FontSize="13" Foreground="#444444"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Results list -->
            <ListBox Grid.Row="1" x:Name="SearchResultList"
                     Background="#0a0a0a"
                     BorderThickness="0"
                     DisplayMemberPath="Name"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="32,10"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1a6fb5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a3a5c"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Virtual keyboard -->
            <Grid Grid.Row="2" x:Name="VirtualKeyboard"
                  Background="#111111" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: numbers -->
                <UniformGrid Grid.Row="0" Rows="1" Margin="8,6,8,3">
                    <Button Content="1" Tag="1" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="2" Tag="2" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="3" Tag="3" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="4" Tag="4" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="5" Tag="5" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="6" Tag="6" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="7" Tag="7" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="8" Tag="8" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="9" Tag="9" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="0" Tag="0" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="⌫" Tag="BACK" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                </UniformGrid>

                <!-- Row 1: qwerty -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="8,3">
                    <Button Content="q" Tag="q" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="w" Tag="w" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="e" Tag="e" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="r" Tag="r" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="t" Tag="t" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="y" Tag="y" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="u" Tag="u" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="i" Tag="i" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="o" Tag="o" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="p" Tag="p" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                </UniformGrid>

                <!-- Row 2: asdf -->
                <UniformGrid Grid.Row="2" Rows="1" Margin="8,3">
                    <Button Content="a" Tag="a" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="s" Tag="s" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="d" Tag="d" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="f" Tag="f" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="g" Tag="g" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="h" Tag="h" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="j" Tag="j" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="k" Tag="k" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="l" Tag="l" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                </UniformGrid>

                <!-- Row 3: zxcv + space -->
                <UniformGrid Grid.Row="3" Rows="1" Margin="8,3,8,6">
                    <Button Content="z" Tag="z" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="x" Tag="x" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="c" Tag="c" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="v" Tag="v" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="b" Tag="b" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="n" Tag="n" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="m" Tag="m" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="{DynamicResource LOCGameSnapFullscreen_Space}" Tag="SPACE" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                    <Button Content="{DynamicResource LOCGameSnapFullscreen_Clear}" Tag="CLEAR" Style="{StaticResource KeyStyle}" Click="Key_Click"/>
                </UniformGrid>
            </Grid>

            <!-- Footer busca -->
            <Grid Grid.Row="3" Background="#0a0a0a">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="32,0">
                    <Border Background="#1a6fb5" CornerRadius="16"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_SelectGame}"
                               Foreground="#aaaaaa" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <Border Background="#333333" CornerRadius="16"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_Back}"
                               Foreground="#aaaaaa" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <TextBlock Text="D-pad"
                               Foreground="#aaaaaa" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource LOCGameSnapFullscreen_Navigate}"
                               Foreground="#555555" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>