<UserControl x:Class="GameSnapPlugin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="620">

    <UserControl.Resources>
        <Style x:Key="TipLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="20,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- Folders -->
            <TextBlock Text="{DynamicResource LOCGameSnap_Folders}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LOCGameSnap_SourceFolder}" Margin="0,0,0,4">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                           Text="{DynamicResource LOCGameSnap_Tip_SourceFolder}"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Text="{Binding Settings.SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource LOCGameSnap_Tip_SourceFolderShort}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource LOCGameSnap_Browse}" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseSourceCommand}"/>
            </Grid>

            <TextBlock Text="{DynamicResource LOCGameSnap_AdditionalSources}" Margin="0,0,0,4">
                <TextBlock.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                   Text="{DynamicResource LOCGameSnap_Tip_AdditionalSources}"/>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBox Text="{Binding AdditionalSourcesText, UpdateSourceTrigger=PropertyChanged}"
                     Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,8"
                     ToolTip="{DynamicResource LOCGameSnap_Tip_AdditionalSourcesShort}"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LOCGameSnap_DestinationBase}" Margin="0,0,0,4">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                           Text="{DynamicResource LOCGameSnap_Tip_DestinationBase}"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Text="{Binding Settings.DestinationBase, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource LOCGameSnap_Tip_DestinationBaseShort}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource LOCGameSnap_Browse}" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseDestinationCommand}"/>
            </Grid>

            <Separator Margin="0,8,0,12"/>

            <!-- Detection -->
            <TextBlock Text="{DynamicResource LOCGameSnap_Detection}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_UsePlayniteDetection}"
                      IsChecked="{Binding Settings.UsePlayniteDetection}"
                      Margin="0,0,0,4"
                      ToolTip="{DynamicResource LOCGameSnap_Tip_UsePlayniteDetection}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_UsePlayniteDetectionLabel}"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_UseWindowFallback}"
                      IsChecked="{Binding Settings.UseWindowFallback}"
                      Margin="0,0,0,4"
                      ToolTip="{DynamicResource LOCGameSnap_Tip_UseWindowFallback}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_UseWindowFallbackLabel}"/>

            <TextBlock Text="{DynamicResource LOCGameSnap_EmulatorPrefixes}" Margin="0,8,0,4"/>
            <TextBox Text="{Binding EmulatorPrefixesText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_EmulatorPrefixes}"/>

            <!-- ✅ 新增：黑名单前缀 -->
            <TextBlock Text="{DynamicResource LOCGameSnap_BlacklistPrefixes}" Margin="0,8,0,4"/>
            <TextBox Text="{Binding BlacklistPrefixesText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Text="{DynamicResource LOCGameSnap_Tip_BlacklistPrefixes}"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_ForceCreateFolder}"
                    IsChecked="{Binding Settings.ForceCreateFolder}"
                    Margin="0,0,0,4"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_ForceCreateFolder}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Text="{DynamicResource LOCGameSnap_Tip_ForceCreateFolderLabel}"/>

            <!-- ✅ 新增：强制创建文件夹的子选项 -->
            <CheckBox Content="{DynamicResource LOCGameSnap_ForceCreateOnGameStart}"
                    IsChecked="{Binding Settings.ForceCreateOnGameStart}"
                    Margin="20,2,0,4"
                    IsEnabled="{Binding Settings.ForceCreateFolder}"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_ForceCreateOnGameStart}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Margin="20,0,0,4"
                    Text="{DynamicResource LOCGameSnap_Tip_ForceCreateOnGameStartLabel}"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_ForceCreateOnScreenshot}"
                    IsChecked="{Binding Settings.ForceCreateOnScreenshot}"
                    Margin="20,2,0,4"
                    IsEnabled="{Binding Settings.ForceCreateFolder}"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_ForceCreateOnScreenshot}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Margin="20,0,0,10"
                    Text="{DynamicResource LOCGameSnap_Tip_ForceCreateOnScreenshotLabel}"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Unmatched -->
            <TextBlock Text="{DynamicResource LOCGameSnap_UnmatchedFiles}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_MoveUnmatched}"
                      IsChecked="{Binding Settings.MoveUnmatchedToFolder}"
                      Margin="0,0,0,4"
                      ToolTip="{DynamicResource LOCGameSnap_Tip_MoveUnmatched}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_MoveUnmatchedLabel}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource LOCGameSnap_UnmatchedFolderName}" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="{DynamicResource LOCGameSnap_Tip_UnmatchedFolderName}"/>
                <TextBox Width="160"
                         Text="{Binding Settings.UnmatchedFolderName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource LOCGameSnap_Tip_UnmatchedFolderNameShort}"/>
            </StackPanel>

            <Separator Margin="0,4,0,12"/>

            <!-- Notifications -->
            <TextBlock Text="{DynamicResource LOCGameSnap_Notifications}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_ShowNotifications}"
                    IsChecked="{Binding Settings.ShowNotifications}"
                    Margin="0,0,0,4"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_ShowNotifications}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Text="{DynamicResource LOCGameSnap_Tip_ShowNotificationsLabel}"/>

            <!-- ✅ 新增：通知时机子选项 -->
            <CheckBox Content="{DynamicResource LOCGameSnap_NotifyOnEachScreenshot}"
                    IsChecked="{Binding Settings.NotifyOnEachScreenshot}"
                    Margin="20,2,0,4"
                    IsEnabled="{Binding Settings.ShowNotifications}"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_NotifyOnEachScreenshot}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Margin="20,0,0,2"
                    Text="{DynamicResource LOCGameSnap_Tip_NotifyOnEachScreenshotLabel}"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_NotifyOnGameEnd}"
                    IsChecked="{Binding Settings.NotifyOnGameEnd}"
                    Margin="20,2,0,4"
                    IsEnabled="{Binding Settings.ShowNotifications}"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_NotifyOnGameEnd}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Margin="20,0,0,10"
                    Text="{DynamicResource LOCGameSnap_Tip_NotifyOnGameEndLabel}"/>

            <!-- 图片分类异常通知 -->
            <CheckBox Content="{DynamicResource LOCGameSnap_EnableMismatchNotification}"
                    IsChecked="{Binding Settings.EnableMismatchNotification}"
                    Margin="0,8,0,4"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_EnableMismatchNotification}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Text="{DynamicResource LOCGameSnap_Tip_EnableMismatchNotificationLabel}"/>

            <!-- 限制通知（子选项，缩进显示） -->
            <CheckBox Content="{DynamicResource LOCGameSnap_LimitNotifications}"
                    IsChecked="{Binding Settings.LimitNotifications}"
                    Margin="20,2,0,4"
                    IsEnabled="{Binding Settings.EnableMismatchNotification}"
                    ToolTip="{DynamicResource LOCGameSnap_Tip_LimitNotifications}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                    Margin="20,0,0,10"
                    Text="{DynamicResource LOCGameSnap_Tip_LimitNotificationsLabel}"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Rename -->
            <TextBlock Text="{DynamicResource LOCGameSnap_RenamePattern}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <TextBox Text="{Binding Settings.RenamePattern, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"
                     ToolTip="{DynamicResource LOCGameSnap_Tip_RenamePattern}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_RenamePatternLabel}"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Backup -->
            <TextBlock Text="{DynamicResource LOCGameSnap_Backup}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_EnableBackup}"
                      IsChecked="{Binding Settings.EnableBackup}"
                      Margin="0,0,0,4"
                      ToolTip="{DynamicResource LOCGameSnap_Tip_EnableBackup}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_EnableBackupLabel}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LOCGameSnap_BackupFolder}" Margin="0,0,0,4"
                               ToolTip="{DynamicResource LOCGameSnap_Tip_BackupFolder}"/>
                    <TextBox Text="{Binding Settings.BackupFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource LOCGameSnap_Tip_BackupFolderShort}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource LOCGameSnap_Browse}" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseBackupCommand}"/>
            </Grid>

            <Separator Margin="0,4,0,12"/>

            <!-- ScreenshotsVisualizer -->
            <TextBlock Text="{DynamicResource LOCGameSnap_SVIntegration}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_EnableSVRefresh}"
                      IsChecked="{Binding Settings.EnableScreenshotsVisualizerRefresh}"
                      Margin="0,0,0,4"
                      ToolTip="{DynamicResource LOCGameSnap_Tip_EnableSVRefresh}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_EnableSVRefreshLabel}"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Steam -->
            <TextBlock Text="{DynamicResource LOCGameSnap_Steam}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource LOCGameSnap_EnableSteam}"
                      IsChecked="{Binding Settings.EnableSteamSupport}"
                      Margin="0,0,0,4"
                      ToolTip="{DynamicResource LOCGameSnap_Tip_EnableSteam}"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="{DynamicResource LOCGameSnap_Tip_EnableSteamLabel}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LOCGameSnap_SteamPath}" Margin="0,0,0,4"
                               ToolTip="{DynamicResource LOCGameSnap_Tip_SteamPath}"/>
                    <TextBox Text="{Binding Settings.SteamPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource LOCGameSnap_Tip_SteamPathShort}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource LOCGameSnap_Browse}" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseSteamCommand}"/>
            </Grid>

            <Separator Margin="0,4,0,12"/>

            <!-- Polling -->
            <TextBlock Text="{DynamicResource LOCGameSnap_PollingInterval}" Margin="0,0,0,4"
                       ToolTip="{DynamicResource LOCGameSnap_Tip_PollingInterval}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Width="60"
                         Text="{Binding Settings.PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource LOCGameSnap_Tip_PollingIntervalShort}"/>
                <TextBlock Text="{DynamicResource LOCGameSnap_PollingNote}"
                           VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <Separator Margin="0,4,0,12"/>

            <!-- Extensions -->
            <TextBlock Text="{DynamicResource LOCGameSnap_FileExtensions}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock Text="{DynamicResource LOCGameSnap_ImageExtensions}" Margin="0,0,0,4"
                       ToolTip="{DynamicResource LOCGameSnap_Tip_ImageExtensions}"/>
            <TextBox Margin="0,0,0,8"
                     Text="{Binding ImageExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource LOCGameSnap_Tip_ImageExtensionsShort}"/>

            <TextBlock Text="{DynamicResource LOCGameSnap_VideoExtensions}" Margin="0,0,0,4"
                       ToolTip="{DynamicResource LOCGameSnap_Tip_VideoExtensions}"/>
            <TextBox Margin="0,0,0,12"
                     Text="{Binding VideoExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource LOCGameSnap_Tip_VideoExtensionsShort}"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Tools -->
            <TextBlock Text="{DynamicResource LOCGameSnap_Tools}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource LOCGameSnap_OpenDictionary}" Padding="10,6" Margin="0,0,8,0"
                        Command="{Binding OpenDictionaryCommand}"
                        ToolTip="{DynamicResource LOCGameSnap_Tip_OpenDictionary}"/>
                <Button Content="{DynamicResource LOCGameSnap_OpenLog}" Padding="10,6"
                        Command="{Binding OpenLogCommand}"
                        ToolTip="{DynamicResource LOCGameSnap_Tip_OpenLog}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>